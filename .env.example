# Copy to backend/.env and fill in. NEVER commit .env (it is in .gitignore).
# Use different values for development, testing and production.

# --- Database (the backend connects as app_service, never as postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dermascreen
DB_USER=app_service
DB_PASSWORD=
DB_SSLMODE=disable        # local computer: disable.  Deployed (Render/Railway): require

# --- Tokens ---
# Long random text, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15

# --- CORS (which websites may call the API) ---
CORS_ALLOW_LOCALHOST=true         # lets Flutter web on any localhost port connect while developing
CORS_ORIGINS=                     # deployed web app address(es), comma separated

# --- Only for create_admin.py (run once by you; the running app never uses these) ---
DB_ADMIN_USER=db_admin
DB_ADMIN_PASSWORD=
